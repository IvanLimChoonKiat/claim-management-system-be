{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ClaimsDatabase": "Data Source=claims.db"
  },
  "Kafka": {
    "Enabled": false,
    "BootstrapServers": "localhost:9092",
    "ConsumerGroupId": "claims-notification-consumer"
  },
  "Jwt": {
    "ExpiryHours": 8
  }
}
